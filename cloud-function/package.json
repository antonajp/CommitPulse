{
  "name": "claude-proxy-function",
  "version": "1.0.0",
  "description": "Cloud Function proxy for Claude API with authentication",
  "main": "dist/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "deploy": "gcloud functions deploy claude-proxy --gen2 --runtime=nodejs20 --region=us-central1 --source=. --entry-point=claudeProxy --trigger-http --allow-unauthenticated",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/functions-framework": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  }
}
